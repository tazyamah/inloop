{
  "format": 1,
  "boundaries": [
    {
      "id": "http-input",
      "question": "外部から届く入力（パス、クエリ、本文、ヘッダー）を、使う前に検証しているか。エラーの応答に内部の情報を出していないか",
      "match": [
        {
          "import": "hono"
        },
        {
          "import": "@hono/node-server"
        }
      ]
    },
    {
      "id": "db-write",
      "question": "SQLは固定の文で、値はプレースホルダーで渡しているか。書き込む値は検証済みか",
      "match": [
        {
          "import": "node:sqlite"
        },
        {
          "symbols": [
            "server/db.ts#Db"
          ]
        }
      ]
    },
    {
      "id": "db-schema",
      "question": "スキーマの変更（テーブルや列の追加・削除・変更）は、既存のデータを壊さないか。移行の手順は決まっているか",
      "match": [
        {
          "table": "*",
          "access": [
            "schema"
          ]
        }
      ]
    },
    {
      "id": "secrets",
      "question": "環境変数の値（秘密情報を含みうる）を、ログや応答や画面に出していないか",
      "match": [
        {
          "global": "process.env"
        }
      ]
    },
    {
      "id": "outbound",
      "question": "外部への通信の宛先と送る内容は決まっているか。宛先を外部からの入力で変えられないか",
      "match": [
        {
          "import": "node:http"
        },
        {
          "import": "node:https"
        },
        {
          "import": "node:net"
        }
      ]
    },
    {
      "id": "process",
      "question": "外部コマンドに渡す引数に、外部からの入力が混ざらないか",
      "match": [
        {
          "import": "node:child_process"
        }
      ]
    },
    {
      "id": "tauri-permissions",
      "question": "画面に許す操作（Tauriの権限）を増やしていないか。増やすなら、その理由と範囲は妥当か",
      "match": [
        {
          "files": [
            "src-tauri/capabilities/**",
            "src-tauri/tauri.conf.json"
          ]
        }
      ]
    },
    {
      "id": "sidecar",
      "question": "同梱サーバーの起動・停止と、渡す値（ポート、データの場所）は妥当か。ほかのプロセスから使われないか",
      "match": [
        {
          "files": [
            "src-tauri/src/**",
            "scripts/build-sidecar.mjs"
          ]
        }
      ]
    }
  ],
  "layers": [
    {
      "id": "test",
      "files": [
        "server/**/*.test.ts"
      ]
    },
    {
      "id": "db",
      "files": [
        "server/db.ts"
      ],
      "mayUse": []
    },
    {
      "id": "http",
      "files": [
        "server/app.ts",
        "server/index.ts"
      ],
      "mayUse": [
        "db"
      ]
    },
    {
      "id": "web",
      "files": [
        "web/**"
      ],
      "mayUse": []
    }
  ]
}
