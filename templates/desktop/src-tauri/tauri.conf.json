{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__APP_NAME__",
  "version": "0.0.0",
  "identifier": "app.inloop.__APP_NAME__",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/server"],
    "resources": { "../dist/web": "dist/web" }
  }
}
